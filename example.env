APP_DEBUG = true

# Debao account binding (enable only after the binding tables and routes are deployed)
DEBAO_BINDING_CONFIRMATION_ENABLED = false
DEBAO_BINDING_PHONE_FALLBACK_ENABLED = false
DEBAO_BINDING_CHALLENGE_URL =
DEBAO_PUBLIC_BASE_URL = https://shop.denlaw.cn

# Aliyun OSS (use a RAM user; never use the Alibaba Cloud root account key)
OSS_ENABLED = false
OSS_ACCESS_KEY_ID =
OSS_ACCESS_KEY_SECRET =
OSS_BUCKET = denshop
OSS_ENDPOINT = oss-cn-beijing-internal.aliyuncs.com
OSS_PUBLIC_URL = https://denshop.oss-cn-beijing.aliyuncs.com

# Wangdiantong ERP OpenAPI
WANGDIAN_ENABLED = false
WANGDIAN_ENVIRONMENT = sandbox
WANGDIAN_SID =
WANGDIAN_APPKEY =
WANGDIAN_APPSECRET =
WANGDIAN_SHOP_NO =
WANGDIAN_ORDER_SYNC_FROM =
WANGDIAN_SHOPXO_WAREHOUSE_ID = 0
WANGDIAN_EXPRESS_MAP = {}
WANGDIAN_ORDER_BATCH_SIZE = 50
WANGDIAN_LOGISTICS_BATCH_SIZE = 100
WANGDIAN_INVENTORY_BATCH_SIZE = 100
WANGDIAN_AFTERSALE_BATCH_SIZE = 10
WANGDIAN_AFTERSALE_QUERY_LOOKBACK = 604800
WANGDIAN_AFTERSALE_AUTO_PROCESS = false
WANGDIAN_AFTERSALE_REFUNDMENT = 0
WANGDIAN_CRON_TOKEN =
WANGDIAN_CRON_ALLOWED_IPS = 127.0.0.1,::1
WANGDIAN_CONNECT_TIMEOUT = 5
WANGDIAN_TIMEOUT = 30

# 企业微信群机器人订单通知（默认关闭；请勿把机器人 webhook 提交到仓库）
ENTERPRISE_WECHAT_ORDER_ENABLED = false
ENTERPRISE_WECHAT_ORDER_WEBHOOK_URL =
ENTERPRISE_WECHAT_ORDER_TIMEOUT = 3
ENTERPRISE_WECHAT_ORDER_MENTION_MOBILES =
