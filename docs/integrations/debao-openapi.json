{
  "openapi": "3.0.3",
  "info": {
    "title": "DeBao x DeShop Integration API",
    "version": "1.0.0",
    "description": "Frozen integration contract. Amounts are integer CNY cents and timestamps are ISO 8601 UTC."
  },
  "servers": [{"url": "https://shop.denlaw.cn/debao/v1"}],
  "security": [{"debaoHmac": []}],
  "paths": {
    "/categories": {"get": {"operationId": "listCategories", "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/ParentId"}], "responses": {"200": {"$ref": "#/components/responses/CategoryList"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/products": {"get": {"operationId": "listProducts", "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/CategoryId"}, {"$ref": "#/components/parameters/UpdatedAfter"}], "responses": {"200": {"$ref": "#/components/responses/ProductList"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/products/{product_id}": {"get": {"operationId": "getProduct", "parameters": [{"$ref": "#/components/parameters/ProductId"}], "responses": {"200": {"$ref": "#/components/responses/Product"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/products/{product_id}/skus": {"get": {"operationId": "listSkus", "parameters": [{"$ref": "#/components/parameters/ProductId"}, {"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"$ref": "#/components/responses/SkuList"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/bindings/challenges": {"post": {"operationId": "createBindingChallenge", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BindingChallengeRequest"}}}}, "responses": {"201": {"$ref": "#/components/responses/BindingChallenge"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/bindings/challenges/{challenge_id}": {"get": {"operationId": "getBindingChallenge", "parameters": [{"$ref": "#/components/parameters/ChallengeId"}], "responses": {"200": {"$ref": "#/components/responses/BindingChallengeStatus"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/bindings/challenges/{challenge_id}/confirm": {"post": {"operationId": "confirmBindingChallenge", "parameters": [{"$ref": "#/components/parameters/ChallengeId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BindingConfirmRequest"}}}}, "responses": {"200": {"$ref": "#/components/responses/BindingStatus"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/bindings/status": {"get": {"operationId": "getBindingStatus", "responses": {"200": {"$ref": "#/components/responses/BindingStatus"}}}},
    "/bindings": {"delete": {"operationId": "unbindUsers", "responses": {"204": {"description": "Binding removed"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/addresses": {"get": {"operationId": "listAddresses", "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}], "responses": {"200": {"$ref": "#/components/responses/AddressList"}}}, "post": {"operationId": "createAddress", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AddressInput"}}}}, "responses": {"201": {"$ref": "#/components/responses/Address"}}}},
    "/addresses/{address_id}": {"patch": {"operationId": "updateAddress", "parameters": [{"$ref": "#/components/parameters/AddressId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AddressInput"}}}}, "responses": {"200": {"$ref": "#/components/responses/Address"}, "404": {"$ref": "#/components/responses/Error"}}}, "delete": {"operationId": "deleteAddress", "parameters": [{"$ref": "#/components/parameters/AddressId"}], "responses": {"204": {"description": "Address deleted"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/addresses/{address_id}/default": {"post": {"operationId": "setDefaultAddress", "parameters": [{"$ref": "#/components/parameters/AddressId"}], "responses": {"200": {"$ref": "#/components/responses/Address"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/sessions/sso": {"post": {"operationId": "createSsoSession", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SsoSessionRequest"}}}}, "responses": {"201": {"$ref": "#/components/responses/Session"}}}},
    "/sessions/checkout": {"post": {"operationId": "createCheckoutSession", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckoutRequest"}}}}, "responses": {"201": {"$ref": "#/components/responses/Checkout"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/sessions/{session_id}": {"get": {"operationId": "getSession", "parameters": [{"$ref": "#/components/parameters/SessionId"}], "responses": {"200": {"$ref": "#/components/responses/Session"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/orders": {"get": {"operationId": "listOrders", "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/OrderStatus"}], "responses": {"200": {"$ref": "#/components/responses/OrderList"}}}},
    "/orders/{order_id}": {"get": {"operationId": "getOrder", "parameters": [{"$ref": "#/components/parameters/OrderId"}], "responses": {"200": {"$ref": "#/components/responses/Order"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/orders/{order_id}/logistics": {"get": {"operationId": "getLogistics", "parameters": [{"$ref": "#/components/parameters/OrderId"}], "responses": {"200": {"$ref": "#/components/responses/Logistics"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/orders/{order_id}/pay": {"post": {"operationId": "createPayment", "parameters": [{"$ref": "#/components/parameters/OrderId"}], "responses": {"200": {"$ref": "#/components/responses/Payment"}, "409": {"$ref": "#/components/responses/Error"}}}},
    "/webhooks/debao-events": {"post": {"operationId": "receiveDebaoEvent", "security": [{"debaoHmac": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookEvent"}}}}, "responses": {"204": {"description": "Processed or already processed"}, "500": {"description": "Retryable failure"}}}}
  },
  "components": {
    "securitySchemes": {"debaoHmac": {"type": "apiKey", "in": "header", "name": "X-Debao-Signature", "description": "HMAC-SHA256; see debao-api-v1.md for canonical string and replay protection."}},
    "parameters": {
      "Cursor": {"name": "cursor", "in": "query", "schema": {"type": "string"}}, "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}}, "ParentId": {"name": "parent_id", "in": "query", "schema": {"type": "string"}}, "CategoryId": {"name": "category_id", "in": "query", "schema": {"type": "string"}}, "UpdatedAfter": {"name": "updated_after", "in": "query", "schema": {"type": "string", "format": "date-time"}}, "ProductId": {"name": "product_id", "in": "path", "required": true, "schema": {"type": "string"}}, "ChallengeId": {"name": "challenge_id", "in": "path", "required": true, "schema": {"type": "string"}}, "AddressId": {"name": "address_id", "in": "path", "required": true, "schema": {"type": "string"}}, "SessionId": {"name": "session_id", "in": "path", "required": true, "schema": {"type": "string"}}, "OrderId": {"name": "order_id", "in": "path", "required": true, "schema": {"type": "string"}}, "OrderStatus": {"name": "status", "in": "query", "schema": {"type": "string"}}
    },
    "schemas": {
      "Category": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "parent_id": {"type": "string", "nullable": true}, "name": {"type": "string"}, "active": {"type": "boolean"}}},
      "Sku": {"type": "object", "required": ["sku_id", "sku_code", "price_cents", "stock", "active"], "properties": {"sku_id": {"type": "string"}, "sku_code": {"type": "string"}, "spec": {"type": "object", "additionalProperties": {"type": "string"}}, "price_cents": {"type": "integer", "minimum": 0}, "original_price_cents": {"type": "integer", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "default": "CNY"}, "stock": {"type": "integer", "minimum": 0}, "active": {"type": "boolean"}}},
      "Product": {"type": "object", "required": ["product_id", "name", "active", "skus"], "properties": {"product_id": {"type": "string"}, "name": {"type": "string"}, "image_url": {"type": "string", "format": "uri"}, "tags": {"type": "array", "items": {"type": "string"}}, "features": {"type": "object", "additionalProperties": true}, "metadata": {"type": "object", "additionalProperties": true}, "category_ids": {"type": "array", "items": {"type": "string"}}, "description": {"type": "string"}, "active": {"type": "boolean"}, "order_model": {"type": "string", "enum": ["physical", "virtual", "pickup", "local_delivery"]}, "requires_agreement": {"type": "boolean"}, "original_price_cents": {"type": "integer", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "default": "CNY"}, "skus": {"type": "array", "items": {"$ref": "#/components/schemas/Sku"}}}},
      "AddressInput": {"type": "object", "required": ["name", "phone", "province", "city", "district", "detail"], "properties": {"name": {"type": "string"}, "phone": {"type": "string"}, "province": {"type": "string"}, "city": {"type": "string"}, "district": {"type": "string"}, "detail": {"type": "string"}, "is_default": {"type": "boolean"}}, "additionalProperties": false},
      "Address": {"allOf": [{"$ref": "#/components/schemas/AddressInput"}, {"type": "object", "required": ["address_id"], "properties": {"address_id": {"type": "string"}}}]},
      "BindingChallengeRequest": {"type": "object", "required": ["debao_user_id", "method"], "properties": {"debao_user_id": {"type": "string"}, "method": {"type": "string", "enum": ["mini_qr", "phone_fallback"]}}},
      "BindingConfirmRequest": {"type": "object", "required": ["confirmation_code"], "properties": {"confirmation_code": {"type": "string"}, "phone_code": {"type": "string"}}},
      "SsoSessionRequest": {"type": "object", "required": ["debao_user_id", "redirect_uri"], "properties": {"debao_user_id": {"type": "string"}, "redirect_uri": {"type": "string", "format": "uri"}, "state": {"type": "string"}}},
      "CheckoutRequest": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sku_id", "quantity"], "properties": {"sku_id": {"type": "string"}, "quantity": {"type": "integer", "minimum": 1}}}}, "address_id": {"type": "string"}}},
       "Session": {"type": "object", "required": ["session_id", "expires_at", "status"], "properties": {"session_id": {"type": "string"}, "expires_at": {"type": "string", "format": "date-time"}, "status": {"type": "string", "enum": ["pending", "consumed", "expired"]}, "one_time": {"type": "boolean"}, "redirect_uri": {"type": "string", "format": "uri"}, "total_cents": {"type": "integer", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "default": "CNY"}, "items": {"type": "array", "items": {"type": "object"}}, "payment_required": {"type": "boolean"}}},
       "Payment": {"type": "object", "required": ["order_id", "amount_cents", "payment_provider", "payment_intent_id"], "properties": {"order_id": {"type": "string"}, "amount_cents": {"type": "integer", "minimum": 0}, "payment_provider": {"type": "string"}, "payment_intent_id": {"type": "string"}}},
      "Order": {"type": "object", "required": ["order_id", "status", "total_cents", "created_at"], "properties": {"order_id": {"type": "string"}, "status": {"type": "string"}, "total_cents": {"type": "integer", "minimum": 0}, "items": {"type": "array", "items": {"type": "object"}}, "agreement_status": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}}},
      "WebhookEvent": {"type": "object", "required": ["event_id", "event_type", "occurred_at", "order_id", "resource_version", "data"], "properties": {"event_id": {"type": "string"}, "event_type": {"type": "string", "enum": ["payment.succeeded", "order.shipped", "order.cancelled", "refund.created", "refund.succeeded"]}, "occurred_at": {"type": "string", "format": "date-time"}, "order_id": {"type": "string"}, "resource_version": {"type": "integer", "minimum": 1}, "data": {"type": "object"}}}
    },
    "responses": {
      "Error": {"description": "Error", "content": {"application/json": {"schema": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message", "request_id"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "request_id": {"type": "string"}, "details": {"type": "object"}}}}}}}},
      "CategoryList": {"description": "Categories", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"type": "object", "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Category"}}, "next_cursor": {"type": "string", "nullable": true}, "has_more": {"type": "boolean"}}}}}}}},
      "ProductList": {"description": "Products", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"type": "object", "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Product"}}, "next_cursor": {"type": "string", "nullable": true}, "has_more": {"type": "boolean"}}}}}}}},
      "Product": {"description": "Product", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/Product"}}}}}}, "SkuList": {"description": "SKUs", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"type": "object", "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Sku"}}, "next_cursor": {"type": "string", "nullable": true}, "has_more": {"type": "boolean"}}}}}}}},
       "BindingChallenge": {"description": "Challenge", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"type": "object"}}}}}}, "BindingChallengeStatus": {"$ref": "#/components/responses/BindingChallenge"}, "BindingStatus": {"$ref": "#/components/responses/BindingChallenge"}, "Address": {"description": "Address", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/Address"}}}}}}, "AddressList": {"$ref": "#/components/responses/CategoryList"}, "Session": {"description": "Session", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/Session"}}}}}}, "Checkout": {"$ref": "#/components/responses/Session"}, "Order": {"description": "Order", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/Order"}}}}}}, "OrderList": {"$ref": "#/components/responses/CategoryList"}, "Logistics": {"$ref": "#/components/responses/Order"}, "Payment": {"description": "Payment intent", "content": {"application/json": {"schema": {"type": "object", "properties": {"data": {"$ref": "#/components/schemas/Payment"}}}}}}
    }
  }
}
